{
  "name": "dtcc-atlaspp-mvp",
  "version": "0.1.0",
  "description": "Standalone projector app for DTCC Atlas++ MVP",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-remote.mjs",
    "dev:remote": "node scripts/dev-remote.mjs",
    "dev:projector": "node scripts/launch-projector.mjs",
    "dev:vite": "vite",
    "control:dev": "ATLAS_REMOTE_PUBLIC_URL=http://127.0.0.1:5175/remote node server/control-server.mjs --port 5176 --host 127.0.0.1",
    "control:serve": "node server/control-server.mjs --port 5175 --host 0.0.0.0 --static dist",
    "build": "tsc --noEmit && vite build",
    "catalog:ingest": "node scripts/ingest-dtcc-manifests.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "svelte": "^5.53.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
